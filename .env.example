# Включённые провайдеры через запятую: antigravity, codex, claude, stub (dev/tests).
# paid_api пока не поддерживается. Если ENABLED_PROVIDERS не задан, используется PROVIDER.
# ENABLED_PROVIDERS=antigravity,codex,claude
# Провайдер по умолчанию (по умолчанию — первый из ENABLED_PROVIDERS, должен быть включён).
# DEFAULT_PROVIDER=codex
# Устаревший одиночный провайдер (используется только если ENABLED_PROVIDERS не задан):
PROVIDER=stub

# Общий токен core и runner. Сгенерируйте значение командой openssl rand -hex 32.
RUNNER_SHARED_SECRET=

# Настройки Antigravity CLI (при PROVIDER=antigravity)
ANTIGRAVITY_MODEL=gemini-3.8-flash-high
# ANTIGRAVITY_MODELS=gemini-3.8-flash-high,gemini-4-hydrogen-medium

# Локальный прокси включается профилем antigravity. В prod он включён по умолчанию.
# AGY_USE_UNLOCKER=true
# AG_LS_PROXY=http://unlocker:53130
# Только контейнер unlocker получает этот код.
AG_UNLOCKER_CODE=

# Индекс локальных чатов Codex (оставьте пустым, если не используется)
CODEX_HISTORY_USERNAME=

# Ограничение одновременных потоков генерации (>= 1)
MAX_CONCURRENT_STREAMS=1

# CORS: * для локальной разработки или точные origin через запятую для продакшена
# Пример для prod: https://console.example.com,https://web.telegram.org
CORS_ORIGIN=*

# Доверять заголовкам прокси (X-Forwarded-For / X-Real-IP) за Caddy
TRUST_PROXY_HEADERS=true

# Домен для автоматического HTTPS (Let's Encrypt) в docker-compose.prod.yml
DOMAIN=console.example.com

# Лимиты тарифа Pro в центах (5 часов и 7 дней)
PRO_LIMIT_5H_CENTS=1500
PRO_LIMIT_7D_CENTS=15000

# Фоновое обновление памяти личных чатов
MEMORY_AUTO_UPDATE=true
# Провайдер для обновления памяти (по умолчанию — DEFAULT_PROVIDER, должен быть включён)
# MEMORY_PROVIDER=
# Рекомендуется указывать самую лёгкую/дешёвую модель (например, gemini-3.8-flash-low),
# чтобы фоновое обновление памяти не расходовало квоту тяжёлой модели
# MEMORY_MODEL=
MEMORY_CHECK_INTERVAL=5m
MEMORY_MIN_NEW_MESSAGES=6

# Проверка Telegram Mini App initData на бэкенде (если используется)
# TELEGRAM_BOT_TOKEN=
TELEGRAM_INIT_DATA_MAX_AGE=1h
