:80 {
	request_body {
		max_size 120MB
	}

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; script-src 'self' https://telegram.org; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https: wss: http: ws:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self' https://web.telegram.org https://*.telegram.org"
	}

	handle /api/* {
		reverse_proxy core:8080
	}

	handle /ws {
		reverse_proxy core:8080
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
